name: Fix News Video Namespace

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - '.github/workflows/fix-news-video-namespace.yml'

permissions:
  contents: write

jobs:
  fix:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Move video hub under /haber/video and redirect legacy paths
        run: |
          python - <<'PY'
          from pathlib import Path

          src_candidates = [Path('video/index.html'), Path('video.html')]
          src = next((p for p in src_candidates if p.exists()), None)
          if src is None:
              raise SystemExit('No video source page found')

          target = Path('haber/video/index.html')
          target.parent.mkdir(parents=True, exist_ok=True)
          content = src.read_text(encoding='utf-8')
          content = content.replace('https://hakancetin.com.tr/video/', 'https://hakancetin.com.tr/haber/video/')
          content = content.replace('href="/video/"', 'href="/haber/video/"')
          content = content.replace('href="/haber/"', 'href="/haber/"')
          content = content.replace('canonical" href="https://hakancetin.com.tr/video/"', 'canonical" href="https://hakancetin.com.tr/haber/video/"')
          target.write_text(content, encoding='utf-8')

          # Redirect legacy /video/ and /video.html to /haber/video/
          redirect_tpl = '''<!DOCTYPE html>\n<html lang="tr">\n<head>\n  <meta charset="UTF-8">\n  <meta name="viewport" content="width=device-width, initial-scale=1.0">\n  <meta http-equiv="refresh" content="0; url=/haber/video/">\n  <meta name="robots" content="noindex,follow">\n  <link rel="canonical" href="https://hakancetin.com.tr/haber/video/">\n  <title>Video merkezine yönlendiriliyorsunuz | hakancetin.com.tr</title>\n  <script>window.location.replace('/haber/video/' + window.location.search + window.location.hash);</script>\n</head>\n<body>\n  <p>Video merkezine yönlendiriliyorsunuz. <a href="/haber/video/">Devam etmek için tıklayın</a>.</p>\n</body>\n</html>\n'''
          Path('video').mkdir(exist_ok=True)
          Path('video/index.html').write_text(redirect_tpl, encoding='utf-8')
          Path('video.html').write_text(redirect_tpl, encoding='utf-8')

          # Fix links inside the news namespace.
          replacements = {
              'href="video/"': 'href="/haber/video/"',
              'href="/video/"': 'href="/haber/video/"',
              'href="video.html': 'href="/haber/video/',
              'href="/video.html': 'href="/haber/video/',
              'video.html?v=': '/haber/video/?v=',
              'video.html?source=': '/haber/video/?source=',
              'video.html?': '/haber/video/?',
          }
          changed = ['haber/video/index.html', 'video/index.html', 'video.html']
          for path in Path('haber').glob('**/*.html'):
              text = path.read_text(encoding='utf-8')
              original = text
              for old, new in replacements.items():
                  text = text.replace(old, new)
              if text != original:
                  path.write_text(text, encoding='utf-8')
                  changed.append(path.as_posix())

          # Ensure any top nav in the video hub points inside haber.
          text = target.read_text(encoding='utf-8')
          text = text.replace('href="/video/"', 'href="/haber/video/"')
          text = text.replace('href="/haber/video/" class="active"', 'class="active" href="/haber/video/"')
          target.write_text(text, encoding='utf-8')

          print('\n'.join(sorted(set(changed))))
          PY
      - name: Commit video namespace fixes
        run: |
          git config user.name "News Video Namespace Fixer"
          git config user.email "news-video-namespace-fixer@users.noreply.github.com"
          git add -A
          if git diff --staged --quiet; then
            echo "No changes."
            exit 0
          fi
          git commit -m "Move video hub under haber namespace"
          git push
